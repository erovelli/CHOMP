# Copy to .env.local and fill in your values.
# .env.local is git-ignored; .env.example is checked in as documentation.

# Protomaps basemap API key.
#
# Optional — without a key, the map falls back to a blank background
# and the choropleth layers still render. With a key, you get the
# labeled vector basemap underneath.
#
# Get one at https://protomaps.com/
VITE_PROTOMAPS_API_KEY=
