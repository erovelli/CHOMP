{
  "name": "dental-map-vite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "deploy": "npm run build && gh-pages -d dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "maplibre-gl": "^5.19.0",
    "papaparse": "^5.4.1",
    "pmtiles": "^4.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "topojson-client": "^3.1.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.0",
    "@types/papaparse": "^5.3.15",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@size-limit/preset-app": "^12.1.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.6",
    "jsdom": "^25.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "size-limit": "^12.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  },
  "size-limit": [
    {
      "name": "JS bundle (gzip, initial)",
      "path": "dist/assets/index-*.js",
      "limit": "380 KB",
      "gzip": true
    },
    {
      "name": "JS bundle (gzip, export chunk, lazy)",
      "path": "dist/assets/ExportModal-*.js",
      "limit": "40 KB",
      "gzip": true
    },
    {
      "name": "CSS bundle (gzip)",
      "path": "dist/assets/*.css",
      "limit": "30 KB",
      "gzip": true
    }
  ]
}
